# PKGBUILD do localvector para Arch (uso pessoal do João; não publicado no AUR).
# Instala a árvore FHS (bin/ + share/) do tarball da release — o mesmo artefato
# que o package.sh gera. O sha256 fica SKIP no repo (o hash só existe após a
# release); o job arch do CI substitui pelo real ao construir o pacote.
#
#   makepkg -si   (local, com o tarball da release ao lado)

pkgname=ai.storyteller.localvector
pkgver=0.21.10
pkgrel=1
pkgdesc='Draw and edit vector illustrations, SVG and PDF'
arch=(x86_64)
url='https://github.com/Anon5T4R/Local-Vector'
license=('MIT OR Apache-2.0')
provides=('localvector')
conflicts=('localvector')
depends=(glibc gcc-libs libxcb libxrandr libxi libxcursor libxkbcommon)
optdepends=('xdg-desktop-portal: seletor nativo de arquivos (GNOME/KDE já trazem)')
options=(!debug)
source=("localvector-$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir"
  install -dm755 "$pkgdir/usr"
  cp -a "localvector-$pkgver-linux-x86_64/bin" "$pkgdir/usr/"
  cp -a "localvector-$pkgver-linux-x86_64/share" "$pkgdir/usr/"
}
