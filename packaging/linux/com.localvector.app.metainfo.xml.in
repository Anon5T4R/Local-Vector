<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.localvector.app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Local Vector</name>
  <summary>Draw and edit vector illustrations, SVG and PDF</summary>
  <developer id="com.localvector">
    <name>Anon5T4R</name>
  </developer>
  <description>
    <p>
      Local Vector is an open-source vector illustration app. Draw with pen, shape and brush tools,
      style art with fills, strokes, gradients and live effects, lay out artboards and type, and
      open and save SVG and PDF.
    </p>
  </description>
  <launchable type="desktop-id">com.localvector.app.desktop</launchable>
  <icon type="stock">com.localvector.app</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/Anon5T4R/Local-Vector</url>
  <url type="bugtracker">https://github.com/Anon5T4R/Local-Vector/issues</url>
  <url type="help">https://github.com/Anon5T4R/Local-Vector</url>
  <url type="contact">https://github.com/Anon5T4R/Local-Vector/discussions</url>
  <categories>
    <category>Graphics</category>
    <category>2DGraphics</category>
    <category>VectorGraphics</category>
  </categories>
  <keywords>
    <keyword>vector</keyword>
    <keyword>illustration</keyword>
    <keyword>svg</keyword>
    <keyword>pdf</keyword>
    <keyword>drawing</keyword>
    <keyword>bezier</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Editing the Neon Drive poster with a live glow effect in the Appearance panel</caption>
      <image>https://raw.githubusercontent.com/Anon5T4R/Local-Vector/main/docs/images/shot-1-neon.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#2dd4bf</color>
    <color type="primary" scheme_preference="dark">#0f766e</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>localvector</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
